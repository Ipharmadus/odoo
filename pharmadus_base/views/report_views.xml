<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_report_view_tree_pharmadus" model="ir.ui.view">
        <field name="name">sale.report.view.list.pharmadus</field>
        <field name="model">sale.report</field>
        <field name="inherit_id" ref="sale.sale_report_view_tree"/>
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="pharmadus_line_id" optional="show"/>
                <field name="pharmadus_subline_id" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_order_product_pivot_pharmadus" model="ir.ui.view">
        <field name="name">sale.report.pivot.pharmadus</field>
        <field name="model">sale.report</field>
        <field name="inherit_id" ref="sale.view_order_product_pivot"/>
        <field name="arch" type="xml">
            <field name="date" position="after">
                <field name="partner_category_id" type="row"/>
                <field name="partner_category_parent_id" type="row"/>
                <field name="pharmadus_line_id" type="row"/>
                <field name="pharmadus_subline_id" type="row"/>
            </field>
        </field>
    </record>

    <record id="view_order_product_search_pharmadus" model="ir.ui.view">
        <field name="name">sale.report.search.pharmadus</field>
        <field name="model">sale.report</field>
        <field name="inherit_id" ref="sale.view_order_product_search"/>
        <field name="arch" type="xml">
            <field name="product_tmpl_id" position="after">
                <field name="partner_category_id"/>
                <field name="partner_category_parent_id"/>
                <field name="pharmadus_line_id"/>
                <field name="pharmadus_subline_id"/>
            </field>
            <filter name="Category" position="after">
                <filter string="Categoría de empresa" name="group_by_partner_category" context="{'group_by':'partner_category_id'}"/>
                <filter string="Categoría padre de empresa" name="group_by_partner_category_parent" context="{'group_by':'partner_category_parent_id'}"/>
                <filter string="Línea" name="group_by_pharmadus_line" context="{'group_by':'pharmadus_line_id'}"/>
                <filter string="SubLínea" name="group_by_pharmadus_subline" context="{'group_by':'pharmadus_subline_id'}"/>
            </filter>
        </field>
    </record>

    <record id="purchase_report_view_tree_pharmadus" model="ir.ui.view">
        <field name="name">purchase.report.view.list.pharmadus</field>
        <field name="model">purchase.report</field>
        <field name="inherit_id" ref="purchase.purchase_report_view_tree"/>
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="pharmadus_purchase_line_id" optional="show"/>
                <field name="pharmadus_purchase_subline_id" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_purchase_order_pivot_pharmadus" model="ir.ui.view">
        <field name="name">purchase.report.pivot.pharmadus</field>
        <field name="model">purchase.report</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_pivot"/>
        <field name="arch" type="xml">
            <field name="order_id" position="after">
                <field name="pharmadus_purchase_line_id" type="row"/>
                <field name="pharmadus_purchase_subline_id" type="row"/>
            </field>
        </field>
    </record>

    <record id="view_purchase_order_search_pharmadus" model="ir.ui.view">
        <field name="name">purchase.report.search.pharmadus</field>
        <field name="model">purchase.report</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_search"/>
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="pharmadus_purchase_line_id"/>
                <field name="pharmadus_purchase_subline_id"/>
            </field>
            <filter name="group_category_id" position="after">
                <filter string="Línea compras" name="group_by_pharmadus_purchase_line" context="{'group_by':'pharmadus_purchase_line_id'}"/>
                <filter string="Sublínea compras" name="group_by_pharmadus_purchase_subline" context="{'group_by':'pharmadus_purchase_subline_id'}"/>
            </filter>
        </field>
    </record>

    <record id="account_invoice_report_view_tree_pharmadus" model="ir.ui.view">
        <field name="name">account.invoice.report.view.list.pharmadus</field>
        <field name="model">account.invoice.report</field>
        <field name="inherit_id" ref="account.account_invoice_report_view_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="commercial_partner_id" string="Entidad comercial" optional="show"/>
                <field name="partner_shipping_id" string="Dirección de entrega" optional="show"/>
                <field name="partner_category_id" string="Categoría de empresa" optional="show"/>
                <field name="partner_category_parent_id" string="Categoría padre de empresa" optional="show"/>
            </field>
            <field name="product_id" position="after">
                <field
                    name="pharmadus_line_id"
                    optional="show"
                    invisible="context.get('pharmadus_hide_sale_specs')"
                />
                <field
                    name="pharmadus_subline_id"
                    optional="show"
                    invisible="context.get('pharmadus_hide_sale_specs')"
                />
                <field
                    name="pharmadus_purchase_line_id"
                    optional="show"
                    invisible="context.get('pharmadus_hide_purchase_specs')"
                />
                <field
                    name="pharmadus_purchase_subline_id"
                    optional="show"
                    invisible="context.get('pharmadus_hide_purchase_specs')"
                />
            </field>
        </field>
    </record>

    <record id="view_account_invoice_report_pivot_pharmadus" model="ir.ui.view">
        <field name="name">account.invoice.report.pivot.pharmadus</field>
        <field name="model">account.invoice.report</field>
        <field name="inherit_id" ref="account.view_account_invoice_report_pivot"/>
        <field name="arch" type="xml">
            <field name="invoice_date" position="after">
                <field name="commercial_partner_id" string="Entidad comercial" type="row"/>
                <field name="partner_shipping_id" string="Dirección de entrega" type="row"/>
                <field name="partner_category_id" string="Categoría de empresa" type="row"/>
                <field name="partner_category_parent_id" string="Categoría padre de empresa" type="row"/>
            </field>
            <field name="invoice_date" position="after">
                <field
                    name="pharmadus_line_id"
                    type="row"
                    invisible="context.get('pharmadus_hide_sale_specs')"
                />
                <field
                    name="pharmadus_subline_id"
                    type="row"
                    invisible="context.get('pharmadus_hide_sale_specs')"
                />
                <field
                    name="pharmadus_purchase_line_id"
                    type="row"
                    invisible="context.get('pharmadus_hide_purchase_specs')"
                />
                <field
                    name="pharmadus_purchase_subline_id"
                    type="row"
                    invisible="context.get('pharmadus_hide_purchase_specs')"
                />
            </field>
        </field>
    </record>

    <record id="view_account_invoice_report_search_pharmadus" model="ir.ui.view">
        <field name="name">account.invoice.report.search.pharmadus</field>
        <field name="model">account.invoice.report</field>
        <field name="inherit_id" ref="account.view_account_invoice_report_search"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="commercial_partner_id" string="Entidad comercial"/>
                <field name="partner_shipping_id" string="Dirección de entrega"/>
                <field name="partner_category_id" string="Categoría de empresa"/>
                <field name="partner_category_parent_id" string="Categoría padre de empresa"/>
            </field>
            <field name="product_id" position="after">
                <field
                    name="pharmadus_line_id"
                    invisible="context.get('pharmadus_hide_sale_specs')"
                />
                <field
                    name="pharmadus_subline_id"
                    invisible="context.get('pharmadus_hide_sale_specs')"
                />
                <field
                    name="pharmadus_purchase_line_id"
                    invisible="context.get('pharmadus_hide_purchase_specs')"
                />
                <field
                    name="pharmadus_purchase_subline_id"
                    invisible="context.get('pharmadus_hide_purchase_specs')"
                />
            </field>
            <filter name="category_product" position="after">
                <filter
                    string="Línea"
                    name="group_by_invoice_pharmadus_line"
                    context="{'group_by':'pharmadus_line_id'}"
                    invisible="context.get('pharmadus_hide_sale_specs')"
                />
                <filter
                    string="SubLínea"
                    name="group_by_invoice_pharmadus_subline"
                    context="{'group_by':'pharmadus_subline_id'}"
                    invisible="context.get('pharmadus_hide_sale_specs')"
                />
                <filter
                    string="Línea compras"
                    name="group_by_invoice_pharmadus_purchase_line"
                    context="{'group_by':'pharmadus_purchase_line_id'}"
                    invisible="context.get('pharmadus_hide_purchase_specs')"
                />
                <filter
                    string="Sublínea compras"
                    name="group_by_invoice_pharmadus_purchase_subline"
                    context="{'group_by':'pharmadus_purchase_subline_id'}"
                    invisible="context.get('pharmadus_hide_purchase_specs')"
                />
                <filter
                    string="Entidad comercial"
                    name="group_by_invoice_commercial_partner"
                    context="{'group_by':'commercial_partner_id'}"
                />
                <filter
                    string="Dirección de entrega"
                    name="group_by_invoice_partner_shipping"
                    context="{'group_by':'partner_shipping_id'}"
                />
                <filter
                    string="Categoría de empresa"
                    name="group_by_invoice_partner_category"
                    context="{'group_by':'partner_category_id'}"
                />
                <filter
                    string="Categoría padre de empresa"
                    name="group_by_invoice_partner_category_parent"
                    context="{'group_by':'partner_category_parent_id'}"
                />
            </filter>
        </field>
    </record>

    <record id="account.action_account_invoice_report_all" model="ir.actions.act_window">
        <field name="context">
            {'search_default_current':1, 'search_default_customer': 1, 'group_by':['invoice_date:month'], 'pharmadus_hide_purchase_specs': True}
        </field>
    </record>

    <record id="account.action_account_invoice_report_all_supp" model="ir.actions.act_window">
        <field name="context">
            {'search_default_current':1, 'search_default_supplier': 1, 'group_by':['invoice_date:month'], 'pharmadus_hide_sale_specs': True}
        </field>
    </record>

    <record id="view_inventory_valuation_search_pharmadus" model="ir.ui.view">
        <field name="name">stock.valuation.layer.search.pharmadus</field>
        <field name="model">stock.valuation.layer</field>
        <field name="inherit_id" ref="stock_account.view_inventory_valuation_search"/>
        <field name="arch" type="xml">
            <field name="product_tmpl_id" position="after">
                <field name="pharmadus_quantity"/>
                <field name="pharmadus_elements_per_outer_box"/>
                <field name="pharmadus_elements_per_display_box"/>
                <field name="pharmadus_elements_per_full_box"/>
                <field name="pharmadus_line_id"/>
                <field name="pharmadus_subline_id"/>
                <field name="pharmadus_packaging_type_id"/>
                <field name="pharmadus_base_form_id"/>
                <field name="pharmadus_garment_id"/>
                <field name="pharmadus_purchase_line_id"/>
                <field name="pharmadus_purchase_subline_id"/>
                <field name="pharmadus_grouping_id"/>
                <field name="pharmadus_subgrouping"/>
            </field>
            <filter name="group_by_categ_id" position="after">
                <filter string="Cantidad" name="group_by_pharmadus_quantity" context="{'group_by':'pharmadus_quantity'}"/>
                <filter string="Elementos por caja contenedora" name="group_by_pharmadus_elements_per_outer_box" context="{'group_by':'pharmadus_elements_per_outer_box'}"/>
                <filter string="Elementos por caja expositora" name="group_by_pharmadus_elements_per_display_box" context="{'group_by':'pharmadus_elements_per_display_box'}"/>
                <filter string="Elementos por caja (Completo)" name="group_by_pharmadus_elements_per_full_box" context="{'group_by':'pharmadus_elements_per_full_box'}"/>
                <filter string="Línea" name="group_by_pharmadus_line" context="{'group_by':'pharmadus_line_id'}"/>
                <filter string="SubLínea" name="group_by_pharmadus_subline" context="{'group_by':'pharmadus_subline_id'}"/>
                <filter string="Envasado" name="group_by_pharmadus_packaging_type" context="{'group_by':'pharmadus_packaging_type_id'}"/>
                <filter string="Forma base" name="group_by_pharmadus_base_form" context="{'group_by':'pharmadus_base_form_id'}"/>
                <filter string="Vestimenta" name="group_by_pharmadus_garment" context="{'group_by':'pharmadus_garment_id'}"/>
                <filter string="Línea compras" name="group_by_pharmadus_purchase_line" context="{'group_by':'pharmadus_purchase_line_id'}"/>
                <filter string="Sublínea compras" name="group_by_pharmadus_purchase_subline" context="{'group_by':'pharmadus_purchase_subline_id'}"/>
                <filter string="Agrupación" name="group_by_pharmadus_grouping" context="{'group_by':'pharmadus_grouping_id'}"/>
                <filter string="Subagrupación" name="group_by_pharmadus_subgrouping" context="{'group_by':'pharmadus_subgrouping'}"/>
            </filter>
        </field>
    </record>
</odoo>
