<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_lot_form_pharmadus_reception" model="ir.ui.view">
        <field name="name">stock.lot.form.pharmadus.reception</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_open_pharmadus_move_history"
                    type="object"
                    class="oe_stat_button"
                    icon="oi-arrow-up"
                    help="Historial de movimientos"
                >
                    <div class="o_stat_info">
                        <span class="o_stat_text">Trazabilidad simple</span>
                    </div>
                </button>
                <button
                    name="action_open_pharmadus_lot_details"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-list-ul"
                    help="Detalles de lote"
                >
                    <div class="o_stat_info">
                        <span class="o_stat_text">Detalles de lote</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="pharmadus_reception" string="Recepción">
                    <group col="4">
                        <group name="pharmadus_reception_packaging">
                            <field name="pharmadus_packaging_type_id"/>
                            <field name="pharmadus_package_count"/>
                            <field name="pharmadus_pallet_count"/>
                        </group>
                        <group
                            name="pharmadus_reception_receipts"
                            string="Albaranes de recepción"
                            colspan="3"
                        >
                            <field
                                name="pharmadus_receipt_picking_ids"
                                nolabel="1"
                                colspan="2"
                                readonly="1"
                            >
                                <list
                                    create="0"
                                    delete="0"
                                    default_order="date_done desc, id desc"
                                >
                                    <field name="name" string="Albarán"/>
                                    <field name="partner_id" string="Proveedor"/>
                                    <field name="date_done" string="Fecha"/>
                                    <field
                                        name="state"
                                        widget="badge"
                                        decoration-success="state == 'done'"
                                    />
                                    <button
                                        name="action_pharmadus_open_receipt"
                                        type="object"
                                        string="Ver albarán"
                                        class="btn-link"
                                        help="Abrir el albarán"
                                    />
                                </list>
                            </field>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_stock_lot_form_quality_buttons" model="ir.ui.view">
        <field name="name">stock.lot.form.quality.buttons</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock_lot_state.view_production_lot_form_state"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_set_approved']" position="attributes">
                <attribute name="groups">quality_control_oca.group_quality_control_manager</attribute>
            </xpath>
            <xpath expr="//button[@name='action_set_rejected']" position="attributes">
                <attribute name="groups">quality_control_oca.group_quality_control_manager</attribute>
            </xpath>
            <xpath expr="//button[@name='action_set_pending']" position="attributes">
                <attribute name="groups">quality_control_oca.group_quality_control_manager</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_move_line_tree_pharmadus_lot_details" model="ir.ui.view">
        <field name="name">stock.move.line.list.pharmadus.lot.details</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date']" position="after">
                <field
                    name="pharmadus_lot_movement_type"
                    widget="badge"
                    optional="show"
                    column_invisible="not context.get('pharmadus_show_lot_details')"
                    decoration-info="pharmadus_lot_movement_type == 'entry'"
                    decoration-success="pharmadus_lot_movement_type == 'approved'"
                    decoration-danger="pharmadus_lot_movement_type == 'rejected'"
                    decoration-primary="pharmadus_lot_movement_type == 'reanalysis'"
                />
            </xpath>
        </field>
    </record>
</odoo>
