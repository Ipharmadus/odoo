<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_pharmadus_specifications" model="ir.ui.view">
        <field name="name">product.template.form.pharmadus.specifications</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']" position="after">
                <page name="pharmadus_specifications" string="Especificaciones">
                    <group>
                        <group>
                            <field name="pharmadus_quantity"/>
                        </group>
                        <group>
                            <field name="pharmadus_elements_per_outer_box"/>
                            <field name="pharmadus_elements_per_display_box"/>
                            <field name="pharmadus_elements_per_full_box"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="pharmadus_line_id"/>
                            <field name="pharmadus_subline_id"/>
                            <field name="pharmadus_packaging_type_id"/>
                            <field name="pharmadus_base_form_id"/>
                            <field name="pharmadus_garment_id"/>
                        </group>
                        <group>
                            <field name="pharmadus_purchase_line_id"/>
                            <field name="pharmadus_purchase_subline_id"/>
                            <field name="pharmadus_grouping_id"/>
                            <field name="pharmadus_subgrouping"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_product_template_form_pharmadus_tags_hide_sales" model="ir.ui.view">
        <field name="name">product.template.form.pharmadus.tags.hide.sales</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales']//field[@name='product_tag_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_product_template_form_pharmadus_cn_code" model="ir.ui.view">
        <field name="name">product.template.form.pharmadus.cn.code</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <field name="barcode" position="after">
                <field
                    name="cn_code"
                    invisible="product_variant_count &gt; 1 or type in ['service', 'combo']"
                />
            </field>
        </field>
    </record>

    <record id="view_product_template_form_pharmadus_tags_below_barcode" model="ir.ui.view">
        <field name="name">product.template.form.pharmadus.tags.below.barcode</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <field name="barcode" position="after">
                <field
                    name="product_tag_ids"
                    widget="many2many_tags"
                    context="{'product_template_id': id}"
                />
            </field>
        </field>
    </record>
</odoo>
