    <template id="report_lot_approved_label">
        <t t-set="label_title" t-value="'APROBADO'"/>
        <t t-call="pharmadus_base.report_lot_state_label"/>
    </template>

    <template id="report_lot_rejected_label">
        <t t-set="label_title" t-value="'RECHAZADO'"/>
        <t t-call="pharmadus_base.report_lot_state_label"/>
    </template>

    <template id="report_lot_state_label">
        <t t-call="web.html_container">
            <style type="text/css">
                /* Etiqueta de 100 x 62 mm (paperformat_lot_state_labels_pharmadus),
                   rehecha el 2026-10-16 copiando la de Odoo 8 que paso el usuario.
                   Posiciones sacadas de aquel PDF (leer_etiqueta_pdf.py), en mm
                   desde arriba: producto 4,3 | referencia 14,7 | TITULO 24,6 |
                   lote 41,1 | fecha y firma 58,8.
                   Todo va CENTRADO, y el titulo y el lote son mas pequenos que en
                   el original (55pt y 35pt): alli los codigos de barras iban en
                   los laterales, girados y saliendose de la etiqueta, y aqui van
                   dentro; medido, con los tamanos originales el bloque se salia
                   del alto.
                   Manias del motor que condicionan el CSS:
                     - no maqueta display:flex, se usan inline-block y bloques;
                     - el paperformat lleva dpi 96 a proposito, o sale una hoja
                       en blanco detras. */
                html, body { margin: 0; padding: 0; }
                .pharmadus-state-label { box-sizing: border-box; font-family: Helvetica, Arial, sans-serif; height: 62mm; overflow: hidden; page-break-inside: avoid; position: relative; width: 100mm; }
                .pharmadus-state-label--break-before { page-break-before: always; }
                /* El nombre del producto puede ser largo y saltar a dos lineas: con
                   line-height 1,1 el bloque se salia de los 62 mm (64,7 medido),
                   asi que va a 0,95 y los margenes entre bloques a 0,5 mm. Con eso
                   dos lineas acaban en 60,7 mm y entran. */
                .pharmadus-state-label__product { font-size: 18.67px; font-weight: 700; line-height: 0.95; margin-top: 0.5mm; overflow: hidden; text-align: center; }
                /* El codigo se pinta fijando SOLO el alto (10 mm) y dejando el
                   ancho automatico: asi se escala de forma uniforme y no se
                   deforma. El ancho del PNG lo calcula _pharmadus_barcode_size()
                   para que cada modulo mida lo mismo de ancho, que es lo que hace
                   que el lector lo reconozca. Fijarle tambien el ancho (o pedirle
                   al widget un ancho redondo) deforma las barras y el codigo se ve
                   pero no se lee.
                   El texto del codigo va MONTADO ENCIMA con fondo blanco, en la
                   misma caja, para que no gaste altura propia. */
                .pharmadus-state-label__barcode { margin-top: 0.5mm; position: relative; text-align: center; }
                .pharmadus-state-label__barcode img { display: block; height: 10mm; margin: 0 auto; }
                .pharmadus-state-label__barcode-text { background: #fff; font-size: 14px; left: 0; line-height: 1; position: absolute; right: 0; text-align: center; top: 0; }
                .pharmadus-state-label__title { font-size: 46px; font-weight: 700; line-height: 1; margin-top: 0.5mm; text-align: center; white-space: nowrap; }
                .pharmadus-state-label__lot { font-size: 40px; font-weight: 700; line-height: 1; margin-top: 0.5mm; text-align: center; white-space: nowrap; }
                .pharmadus-state-label__footer { font-size: 20px; line-height: 1.2; margin-top: 0.5mm; overflow: hidden; white-space: nowrap; }
                .pharmadus-state-label__footer-fecha { display: inline-block; margin-left: 3mm; }
                .pharmadus-state-label__footer-firma { display: inline-block; margin-left: 3mm; }
                .pharmadus-state-label__signature { border-bottom: 1px solid #000; display: inline-block; height: 4mm; margin-left: 2mm; vertical-align: bottom; width: 30mm; }
            </style>
            <t t-set="has_previous_label" t-value="False"/>
            <t t-foreach="docs" t-as="lot">
                <t t-set="lot_barcode" t-value="(lot.name or '').replace('-', '/')"/>
                <t t-set="product_barcode" t-value="(lot.product_id.default_code or '').replace('-', '/')"/>
                <!-- El ancho del PNG tiene que ser multiplo exacto del numero de
                     modulos del Code128, o reportlab reparte los modulos y las
                     barras salen deformadas (se ven, pero el lector no las lee).
                     El helper devuelve (ancho_px, alto_px) ya proporcionado. -->
                <t t-set="product_size" t-value="lot._pharmadus_barcode_size(product_barcode) if product_barcode else (0, 0)"/>
                <t t-set="lot_size" t-value="lot._pharmadus_barcode_size(lot_barcode)"/>
                <div t-att-class="'pharmadus-state-label%s' % (' pharmadus-state-label--break-before' if has_previous_label else '')">
                    <div class="pharmadus-state-label__product" t-out="lot.product_id.name or ''"/>
                    <div t-if="product_barcode" class="pharmadus-state-label__barcode">
                        <span t-out="product_barcode" t-options="{'widget': 'barcode', 'symbology': 'Code128', 'width': product_size[0], 'height': product_size[1], 'quiet': 0, 'img_style': 'display:block;'}"/>
                        <div class="pharmadus-state-label__barcode-text" t-out="lot.product_id.default_code or ''"/>
                    </div>
                    <div class="pharmadus-state-label__title" t-out="label_title"/>
                    <div class="pharmadus-state-label__lot" t-out="lot.name or ''"/>
                    <div class="pharmadus-state-label__barcode">
                        <span t-out="lot_barcode" t-options="{'widget': 'barcode', 'symbology': 'Code128', 'width': lot_size[0], 'height': lot_size[1], 'quiet': 0, 'img_style': 'display:block;'}"/>
                    </div>
                    <div class="pharmadus-state-label__footer">
                        <span class="pharmadus-state-label__footer-fecha">Fecha: <t t-out="context_timestamp(datetime.datetime.now()).strftime('%d-%m-%Y')"/></span>
                        <span class="pharmadus-state-label__footer-firma">Firma:<span class="pharmadus-state-label__signature"/></span>
                    </div>
                </div>
                <t t-set="has_previous_label" t-value="True"/>
            </t>
        </t>
    </template>

    <record id="action_report_lot_sampling_reception_label" model="ir.actions.report">
        <field name="name">Rec. - Etiqueta de muestreo</field>
