<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_lot_labels_pharmadus" model="report.paperformat">
        <field name="name">Pharmadus Lot Labels</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>
        <field name="page_height">148</field>
        <field name="page_width">105</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="disable_shrinking" eval="True"/>
        <!-- dpi 96 y no 90: con cualquier otro valor Odoo anade un zoom de 96/dpi y
             la etiqueta, que mide exactamente el papel, se sale y sale una hoja
             en blanco detras. -->
        <field name="dpi">96</field>
    </record>

    <record id="paperformat_lot_reception_labels_pharmadus" model="report.paperformat">
        <field name="name">Pharmadus Reception Lot Labels</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>
        <field name="page_height">62</field>
        <field name="page_width">28</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="disable_shrinking" eval="True"/>
        <field name="dpi">96</field>
    </record>

    <record id="paperformat_lot_state_labels_pharmadus" model="report.paperformat">
        <field name="name">Pharmadus Lot State Labels</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>
        <field name="page_height">62</field>
        <field name="page_width">100</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="disable_shrinking" eval="True"/>
        <field name="dpi">96</field>
    </record>

    <template id="report_lot_labels">
        <t t-call="web.html_container">
            <style type="text/css">
                html,
                body {
                    margin: 0;
                    padding: 0;
                }
                p {
                    margin: 0;
                    padding: 0;
                }
                .pharmadus-lot-label {
                    box-sizing: border-box;
                    height: 90mm;
                    overflow: hidden;
                    padding: 2mm 14mm 2mm 6mm;
                    page-break-inside: avoid;
                    width: 148mm;
                }
                .pharmadus-lot-label--break-before {
                    page-break-before: always;
                }
                .pharmadus-lot-label__content {
                    margin: 0 auto;
                    page-break-inside: avoid;
                    width: 126mm;
                }
                .pharmadus-lot-label__logo {
                    height: 14mm;
                    text-align: right;
                }
                .pharmadus-lot-label__logo img {
                    max-height: 13mm;
                    max-width: 42mm;
                }
                .pharmadus-lot-label__partner {
                    font-size: 17px;
                    font-weight: 700;
                    line-height: 1.05;
                    max-height: 9mm;
                    overflow: hidden;
                }
                .pharmadus-lot-label__supplier-lot {
                    font-size: 17px;
                    font-weight: 700;
                    line-height: 1.05;
                    max-height: 9mm;
                    min-height: 5mm;
                    overflow: hidden;
                }
                .pharmadus-lot-label__counter {
                    font-size: 19px;
                    font-weight: 700;
                    line-height: 1.05;
                    margin-top: 1mm;
                    min-height: 6mm;
                    text-align: right;
                }
                .pharmadus-lot-label__block {
                    margin-top: 3mm;
                    page-break-inside: avoid;
                }
                .pharmadus-lot-label__barcode {
                    display: block;
                    height: 11mm;
                    margin: 0 auto;
                    width: 126mm;
                }
                .pharmadus-lot-label__caption {
                    font-size: 11px;
                    line-height: 1.1;
                    margin-top: 0.8mm;
                    text-align: center;
                }
                .pharmadus-lot-label__product {
                    font-size: 19px;
                    font-weight: 700;
                    line-height: 1.05;
                    margin-top: 1.2mm;
                    max-height: 10mm;
                    overflow: hidden;
                    text-align: center;
                }
                .pharmadus-lot-label__lot {
                    font-size: 45px;
                    line-height: 0.95;
                    margin-top: 0.8mm;
                    max-height: 18mm;
                    overflow: hidden;
                    text-align: center;
                }
            </style>
            <t t-set="printing_user" t-value="env.user"/>
            <t t-set="print_date" t-value="context_timestamp(datetime.datetime.now())"/>
            <t t-set="has_previous_label" t-value="False"/>
            <t t-foreach="docs" t-as="picking">
                <t
                    t-set="lots"
                    t-value="picking.move_line_ids.filtered(lambda ml: ml.lot_id and ml.quantity &gt; 0).mapped('lot_id').sorted(key=lambda lot: (lot.product_id.display_name or '', lot.name or ''))"
                />
                <t t-foreach="lots" t-as="lot">
                    <t t-set="labels_to_print" t-value="lot._pharmadus_get_labels_to_print()"/>
                    <t t-foreach="labels_to_print" t-as="label_data">
                        <div t-att-class="'pharmadus-lot-label%s' % (' pharmadus-lot-label--break-before' if has_previous_label else '')">
                            <div class="pharmadus-lot-label__content">
                                <div class="pharmadus-lot-label__logo">
                                    <img
                                        t-if="picking.company_id.logo"
                                        t-att-src="image_data_uri(picking.company_id.logo)"
                                        alt="Logo"
                                    />
                                </div>

                                <div>
                                    <p class="pharmadus-lot-label__partner" t-out="picking.partner_id.display_name or ''"/>
                                    <p class="pharmadus-lot-label__supplier-lot" t-out="lot.ref or ''"/>
                                    <p class="pharmadus-lot-label__counter" t-out="label_data['display']"/>
                                </div>

                                <div class="pharmadus-lot-label__block">
                                    <t t-set="product_barcode" t-value="(lot.product_id.default_code or '').replace('-', '/')"/>
                                    <t t-if="product_barcode">
                                        <span
                                            class="pharmadus-lot-label__barcode"
                                            t-out="product_barcode"
                                            t-options="{'widget': 'barcode', 'symbology': 'Code128', 'width': 1200, 'height': 120, 'quiet': 0, 'img_style': 'display:block;width:126mm;height:11mm;'}"
                                        />
                                        <div class="pharmadus-lot-label__caption" t-out="lot.product_id.default_code or ''"/>
                                        <div class="pharmadus-lot-label__product" t-out="lot.product_id.name or ''"/>
                                    </t>
                                </div>

                                <div class="pharmadus-lot-label__block">
                                    <t t-set="lot_barcode" t-value="(lot.name or '').replace('-', '/')"/>
                                    <span
                                        class="pharmadus-lot-label__barcode"
                                        t-out="lot_barcode"
                                        t-options="{'widget': 'barcode', 'symbology': 'Code128', 'width': 1200, 'height': 120, 'quiet': 0, 'img_style': 'display:block;width:126mm;height:11mm;'}"
                                    />
                                    <div class="pharmadus-lot-label__lot" t-out="lot.name or ''"/>
                                </div>
                            </div>
                        </div>
                        <t t-set="has_previous_label" t-value="True"/>
                    </t>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_lot_labels" model="ir.actions.report">
        <field name="name">Etiquetas de lotes</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pharmadus_base.report_lot_labels</field>
        <field name="report_file">pharmadus_base.report_lot_labels</field>
        <field name="paperformat_id" ref="pharmadus_base.paperformat_lot_labels_pharmadus"/>
        <field name="print_report_name">'Etiquetas de lotes - %s' % (object.name)</field>
        <field name="binding_model_id" eval="False"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_lot_sampling_label">
        <t t-call="web.html_container">
            <style type="text/css">
                html, body { margin: 0; padding: 0; }
                .pharmadus-sampling-label { box-sizing: border-box; height: 28mm; overflow: hidden; padding: 1mm 2mm; page-break-inside: avoid; width: 62mm; }
                .pharmadus-sampling-label--break-before { page-break-before: always; }
                .pharmadus-sampling-label__title { font-size: 9px; font-weight: 700; line-height: 1.05; text-align: center; }
                .pharmadus-sampling-label__barcode { display: block; margin: 0 auto; width: 54mm; }
                .pharmadus-sampling-label__main { font-size: 22px; font-weight: 700; line-height: 1; text-align: center; }
                .pharmadus-sampling-label__lot { font-size: 12px; font-weight: 700; line-height: 1; text-align: center; }
                .pharmadus-sampling-label__footer { align-items: flex-end; display: flex; font-size: 9px; justify-content: space-between; margin-top: 1mm; }
                .pharmadus-sampling-label__signature { border-bottom: 1px solid #000; height: 7mm; min-width: 18mm; text-align: center; }
                .pharmadus-sampling-label__signature img { max-height: 6mm; max-width: 17mm; }
            </style>
            <t t-set="printing_user" t-value="env.user"/>
            <t t-set="has_previous_label" t-value="False"/>
            <t t-foreach="docs" t-as="lot">
                <div t-att-class="'pharmadus-sampling-label%s' % (' pharmadus-sampling-label--break-before' if has_previous_label else '')">
                    <div class="pharmadus-sampling-label__title" t-out="lot.product_id.name or ''"/>
                    <t t-set="product_barcode" t-value="(lot.product_id.default_code or '').replace('-', '/')"/>
                    <span t-if="product_barcode" class="pharmadus-sampling-label__barcode" t-out="product_barcode" t-options="{'widget': 'barcode', 'symbology': 'Code128', 'width': 700, 'height': 50, 'quiet': 0, 'img_style': 'display:block;width:54mm;height:5mm;'}"/>
                    <div t-if="lot.product_id.default_code" style="font-size: 7px; text-align: center;" t-out="lot.product_id.default_code"/>
                    <div class="pharmadus-sampling-label__main" t-out="label_title"/>
                    <div class="pharmadus-sampling-label__lot">Lote: <t t-out="lot.name or ''"/></div>
                    <t t-set="lot_barcode" t-value="(lot.name or '').replace('-', '/')"/>
                    <span class="pharmadus-sampling-label__barcode" t-out="lot_barcode" t-options="{'widget': 'barcode', 'symbology': 'Code128', 'width': 700, 'height': 45, 'quiet': 0, 'img_style': 'display:block;width:54mm;height:5mm;'}"/>
                    <div class="pharmadus-sampling-label__footer">
                        <div>Fecha: <t t-out="context_timestamp(datetime.datetime.now()).strftime('%d-%m-%Y')"/></div>
                        <div>Firma:</div>
                        <div class="pharmadus-sampling-label__signature">
                            <img t-if="printing_user.pharmadus_signature_image" t-att-src="image_data_uri(printing_user.pharmadus_signature_image)" alt="Firma"/>
                        </div>
                    </div>
                </div>
                <t t-set="has_previous_label" t-value="True"/>
            </t>
        </t>
    </template>

    <template id="report_lot_sampling_reception_label">
        <t t-call="web.html_container">
            <style type="text/css">
                /* Etiqueta de 62 x 28 mm (paperformat_lot_reception_labels_pharmadus).
                   Dos manias del motor de wkhtmltopdf 0.12.6 que hay que respetar:
                     - no maqueta display:flex, asi que las filas van con
                       inline-block y ancho fijo, o el valor se cae a la linea de abajo;
                     - el paperformat lleva dpi 96 a proposito: con dpi 90 Odoo anade
                       --zoom 1.0667 y la etiqueta, que mide justo el papel, se sale
                       y se imprime una segunda etiqueta en blanco.
                   Los codigos de barras laterales se quitaron el 2026-10-16: al ir
                   girados, el motor los rasterizaba a ~137 px y salian con grises
                   ilegibles (ver ESTADO, apartado 13.5). */
                html, body { margin: 0; padding: 0; }
                .pharmadus-sampling-reception { box-sizing: border-box; font-family: Helvetica, Arial, sans-serif; height: 28mm; overflow: hidden; page-break-inside: avoid; position: relative; width: 62mm; }
                .pharmadus-sampling-reception--break-before { page-break-before: always; }
                .pharmadus-sampling-reception__content { box-sizing: border-box; margin-left: 5mm; margin-right: 5mm; padding-top: 0.5mm; }
                /* El nombre del producto puede ser largo: en vez de recortarlo se
                   deja que salte de linea, y lo que viene detras (lote, referencia,
                   fecha, persona) baja con el. Abajo hay sitio de sobra. */
                .pharmadus-sampling-reception__product { font-size: 10px; font-weight: 700; line-height: 1.05; overflow: hidden; }
                .pharmadus-sampling-reception__lot { font-size: 18.67px; font-weight: 700; line-height: 1; margin-top: 0.4mm; white-space: nowrap; }
                /* La referencia del producto, a la mitad que el lote. */
                .pharmadus-sampling-reception__ref { font-size: 9.33px; font-weight: 700; line-height: 1; margin-top: 0.3mm; white-space: nowrap; }
                .pharmadus-sampling-reception__row { font-size: 8.5px; line-height: 1.2; margin-top: 1.1mm; overflow: hidden; white-space: nowrap; }
                .pharmadus-sampling-reception__label { display: inline-block; width: 23mm; }
                .pharmadus-sampling-reception__value { display: inline-block; }
            </style>
            <t t-set="has_previous_label" t-value="False"/>
            <t t-foreach="docs" t-as="lot">
                <div t-att-class="'pharmadus-sampling-reception%s' % (' pharmadus-sampling-reception--break-before' if has_previous_label else '')">
                    <div class="pharmadus-sampling-reception__content">
                        <div class="pharmadus-sampling-reception__product" t-out="lot.product_id.name or ''"/>
                        <div class="pharmadus-sampling-reception__lot" t-out="lot.name or ''"/>
                        <div t-if="lot.product_id.default_code" class="pharmadus-sampling-reception__ref" t-out="lot.product_id.default_code"/>
                        <div class="pharmadus-sampling-reception__row">
                            <div class="pharmadus-sampling-reception__label">Fecha toma muestra:</div>
                            <!-- La fecha es la de CREACION del lote, que es cuando
                                 entro la mercancia, no la de impresion. El campo
                                 date_in no sirve: en los lotes de materia prima
                                 recientes esta vacio (comprobado en 92953). -->
                            <div class="pharmadus-sampling-reception__value" t-out="(lot.create_date and context_timestamp(lot.create_date) or context_timestamp(datetime.datetime.now())).strftime('%d/%m/%Y')"/>
                        </div>
                        <div class="pharmadus-sampling-reception__row">
                            <div class="pharmadus-sampling-reception__label">Realizado por:</div>
                            <div class="pharmadus-sampling-reception__value" t-out="env.user.name"/>
                        </div>
                    </div>
                </div>
                <t t-set="has_previous_label" t-value="True"/>
            </t>
        </t>
    </template>

    <template id="report_lot_sampled_package_label">
        <t t-call="web.html_container">
            <style type="text/css">
                html, body { margin: 0; padding: 0; }
                .pharmadus-sampled-package { box-sizing: border-box; height: 28mm; overflow: hidden; padding: 1mm 2mm; page-break-inside: avoid; width: 62mm; }
                .pharmadus-sampled-package--break-before { page-break-before: always; }
                .pharmadus-sampled-package__logo img { max-height: 5mm; max-width: 18mm; }
                .pharmadus-sampled-package__title { border-bottom: 1px solid #000; font-size: 20px; font-weight: 700; line-height: 1.05; margin-top: 1mm; text-align: center; }
                .pharmadus-sampled-package__row { font-size: 10px; line-height: 1.2; margin-top: 3mm; }
                .pharmadus-sampled-package__row strong { font-weight: 700; }
            </style>
            <t t-set="printing_user" t-value="env.user"/>
            <t t-set="has_previous_label" t-value="False"/>
            <t t-foreach="docs" t-as="lot">
                <div t-att-class="'pharmadus-sampled-package%s' % (' pharmadus-sampled-package--break-before' if has_previous_label else '')">
                    <div class="pharmadus-sampled-package__logo">
                        <img t-if="lot.company_id.logo" t-att-src="image_data_uri(lot.company_id.logo)" alt="Logo"/>
                    </div>
                    <div class="pharmadus-sampled-package__title">ENVASE MUESTREADO</div>
                    <div class="pharmadus-sampled-package__row"><strong>FECHA:</strong> <t t-out="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y')"/></div>
                    <div class="pharmadus-sampled-package__row"><strong>REALIZA:</strong> <t t-out="printing_user.name"/></div>
                </div>
