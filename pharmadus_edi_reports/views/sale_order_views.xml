<odoo>
    <record id="view_sale_order_form_edi" model="ir.ui.view">
        <field name="name">sale.order.form.edi</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sale_shipping']" position="inside">
                <field name="customer_branch"/>
                <field name="customer_department"/>
                <field name="customer_transmitter"/>
                <field name="top_date"/>
            </xpath>
        </field>
    </record>
</odoo>
