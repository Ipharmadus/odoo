<odoo>
    <template id="report_delivery_note">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="mt0">
                            <span t-field="o.picking_type_id"/>:
                            <span t-field="o.name"/>
                        </h2>

                        <div class="row mt-3 mb-3" style="font-size: 12px;">
                            <div class="col-6">
                                <strong>Dirección de entrega</strong><br/>
                                <span t-field="o.partner_id.name"/><br/>
                                <span t-field="o.partner_id.street"/>
                                <t t-if="o.partner_id.street2">
                                    <br/><span t-field="o.partner_id.street2"/>
                                </t>
                                <br/>
                                <span t-field="o.partner_id.zip"/>
                                <span t-field="o.partner_id.city"/><br/>
                                <span t-field="o.partner_id.state_id"/>
                                (<span t-field="o.partner_id.country_id"/>)<br/>
                                <t t-if="o.partner_id.phone">
                                    Tel. <span t-field="o.partner_id.phone"/><br/>
                                </t>
                                <t t-if="o.partner_id.vat">
                                    NIF: <span t-field="o.partner_id.vat"/>
                                </t>
                            </div>
                            <div class="col-6">
                                <p t-if="o.origin">
                                    <strong>Pedido:</strong>
                                    <span t-field="o.origin"/>
                                </p>
                                <p t-if="o.sale_id and o.sale_id.client_order_ref">
                                    <strong>Ref. cliente:</strong>
                                    <span t-field="o.sale_id.client_order_ref"/>
                                </p>
                                <p>
                                    <strong>Fecha:</strong>
                                    <span t-field="o.scheduled_date"/>
                                </p>
                                <p t-if="o.carrier_id">
                                    <strong>Transportista:</strong>
                                    <span t-field="o.carrier_id"/>
                                </p>
                            </div>
                        </div>

                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th class="text-center">(C+R)</th>
                                    <th class="text-center">Palet</th>
                                    <th class="text-center">Comp.</th>
                                    <th class="text-center">Bulto</th>
                                    <th class="text-center">Resto</th>
                                    <th>Descripción</th>
                                    <th class="text-end">Cantidad</th>
                                    <th>Lote</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="lines"
                                   t-value="o.move_line_ids.filtered(lambda line: line.state != 'cancel').sorted(lambda line: (line.pharmadus_palet or 0, line.pharmadus_bulto or 0, line.product_id.id, line.id))"/>
                                <tr t-foreach="lines" t-as="line">
                                    <td class="text-center">
                                        <span t-out="'(%g+%g)' % (line.pharmadus_complete, line.pharmadus_rest)"/>
                                    </td>
                                    <td class="text-center">
                                        <span t-field="line.pharmadus_palet"/>
                                    </td>
                                    <td class="text-center">
                                        <span t-field="line.pharmadus_complete"/>
                                    </td>
                                    <td class="text-center">
                                        <span t-field="line.pharmadus_bulto"/>
                                    </td>
                                    <td class="text-center">
                                        <t t-if="line.pharmadus_rest">
                                            <span t-out="'%g' % line.pharmadus_rest"/>
                                        </t>
                                    </td>
                                    <td>
                                        <span t-field="line.product_id.display_name"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-out="'%g' % line.quantity"/>
                                    </td>
                                    <td>
                                        <span t-field="line.lot_id"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="row mt-3">
                            <div class="col-4">
                                <strong>Total completos:</strong>
                                <span t-field="o.complete"/>
                            </div>
                            <div class="col-4">
                                <strong>Bultos:</strong>
                                <span t-field="o.number_of_packages"/>
                                (<span t-field="o.pharmadus_total_packages"/> calculados)
                            </div>
                            <div class="col-4">
                                <strong>Palets:</strong>
                                <span t-field="o.number_of_palets"/>
                            </div>
                        </div>

                        <div class="row mt-2" t-if="o.picking_type_code == 'outgoing'">
                            <div class="col-6">
                                <strong>Peso real:</strong>
                                <span t-out="'%g' % o.real_weight"/> kg
                                <span class="text-muted">
                                    (estimado <span t-out="'%.2f' % o.weight"/> kg)
                                </span>
                            </div>
                        </div>

                        <div class="mt-3" t-if="o.note">
                            <strong>Observaciones:</strong>
                            <p t-field="o.note"/>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
