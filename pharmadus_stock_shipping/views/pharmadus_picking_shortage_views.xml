<odoo>
    <record id="view_pharmadus_picking_shortage_form" model="ir.ui.view">
        <field name="name">pharmadus.picking.shortage.form</field>
        <field name="model">pharmadus.picking.shortage.wizard</field>
        <field name="arch" type="xml">
            <form string="Existencias insuficientes">
                <field name="picking_id" invisible="1"/>
                <div class="alert alert-warning" role="alert">
                    <strong>No hay existencias suficientes para completar el albarán.</strong>
                </div>
                <field name="summary" readonly="1" nolabel="1"/>
                <footer>
                    <button name="action_print"
                            string="Generar PDF"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancelar"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
