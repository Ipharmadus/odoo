<odoo>
    <record id="view_product_template_form_pharmadus_shipping" model="ir.ui.view">
        <field name="name">product.template.form.pharmadus.shipping</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_lots_and_weight']" position="inside">
                <field name="pharmadus_is_shipping_box"/>
                <field name="pharmadus_expedition_name"
                       invisible="not pharmadus_is_shipping_box"/>
                <label for="pharmadus_expedition_width"
                       string="Medidas caja (cm)"
                       invisible="not pharmadus_is_shipping_box"/>
                <div class="o_row" invisible="not pharmadus_is_shipping_box">
                    <field name="pharmadus_expedition_width" nolabel="1" placeholder="Ancho"/>
                    <field name="pharmadus_expedition_height" nolabel="1" placeholder="Alto"/>
                    <field name="pharmadus_expedition_depth" nolabel="1" placeholder="Fondo"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
