<odoo>
    <record id="view_pharmadus_expeditions_tree" model="ir.ui.view">
        <field name="name">pharmadus.expeditions.tree</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <list string="Expediciones" create="0" edit="0" delete="0">
                <header>
                    <button name="action_pharmadus_expedition_report"
                            string="Informe de expedición"
                            type="object"
                            class="btn-secondary"/>
                    <button name="action_pharmadus_expedition_xlsx"
                            string="Generar Excel"
                            type="object"
                            class="btn-secondary"/>
                    <button name="action_pharmadus_mark_sent"
                            string="Marcar enviada"
                            type="object"
                            class="btn-secondary"/>
                </header>
                <field name="date_done" string="Fecha"/>
                <field name="name" string="Albarán"/>
                <field name="partner_id" string="Cliente"/>
                <field name="pharmadus_expedition_zip" string="C.P."/>
                <field name="pharmadus_expedition_city" string="Población"/>
                <field name="pharmadus_expedition_state_id" string="Provincia"/>
                <field name="carrier_id" string="Transportista"/>
                <field name="real_weight" string="Peso"/>
                <field name="pharmadus_expedition_sent" string="Enviada"/>
            </list>
        </field>
    </record>

    <record id="view_pharmadus_expeditions_search" model="ir.ui.view">
        <field name="name">pharmadus.expeditions.search</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <search string="Expediciones">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="carrier_id"/>
                <filter name="filter_not_sent"
                        string="No enviadas"
                        domain="[('pharmadus_expedition_sent', '=', 0)]"/>
                <filter name="filter_sent"
                        string="Enviadas"
                        domain="[('pharmadus_expedition_sent', '&gt;', 0)]"/>
                <group expand="1" string="Agrupar por">
                    <filter name="group_by_day"
                            string="Día"
                            context="{'group_by': 'date_done:day'}"/>
                    <filter name="group_by_carrier"
                            string="Transportista"
                            context="{'group_by': 'carrier_id'}"/>
                    <filter name="group_by_partner"
                            string="Cliente"
                            context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pharmadus_expeditions" model="ir.actions.act_window">
        <field name="name">Expediciones</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list</field>
        <field name="domain">[('picking_type_code', '=', 'outgoing'), ('state', '=', 'done')]</field>
        <field name="context">{'search_default_filter_not_sent': 1, 'search_default_group_by_day': 1, 'search_default_group_by_carrier': 1}</field>
        <field name="view_id" ref="view_pharmadus_expeditions_tree"/>
        <field name="search_view_id" ref="view_pharmadus_expeditions_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Todavía no hay expediciones.
            </p>
            <p>
                Aquí aparecen los albaranes de salida validados, agrupados por
                transportista y día, con el peso y el estado de envío.
            </p>
        </field>
    </record>

    <!-- El menú estándar «Operaciones» queda como menú técnico; el menú
         operativo para el grupo Almacén/Usuario es «Operaciones de almacén». -->
    <record id="stock.menu_stock_warehouse_mgmt" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('base.group_no_one')])]"/>
    </record>

    <menuitem id="menu_pharmadus_warehouse_ops"
              name="Operaciones de almacén"
              parent="stock.menu_stock_root"
              sequence="3"
              groups="stock.group_stock_user"/>

    <menuitem id="menu_pharmadus_warehouse_receipts"
              name="Recepciones"
              parent="menu_pharmadus_warehouse_ops"
              action="stock.action_picking_tree_incoming"
              sequence="1"/>

    <menuitem id="menu_pharmadus_warehouse_deliveries"
              name="Entregas"
              parent="menu_pharmadus_warehouse_ops"
              action="stock.action_picking_tree_outgoing"
              sequence="2"/>

    <menuitem id="menu_pharmadus_warehouse_internal"
              name="Interno"
              parent="menu_pharmadus_warehouse_ops"
              action="stock.action_picking_tree_internal"
              sequence="3"/>

    <menuitem id="menu_pharmadus_expeditions"
              name="Expediciones"
              parent="menu_pharmadus_warehouse_ops"
              action="action_pharmadus_expeditions"
              sequence="4"
              groups="stock.group_stock_user"/>
</odoo>
