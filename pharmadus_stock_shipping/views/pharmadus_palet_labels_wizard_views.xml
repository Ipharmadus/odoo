<odoo>
    <record id="view_pharmadus_palet_labels_wizard_form" model="ir.ui.view">
        <field name="name">pharmadus.palet.labels.wizard.form</field>
        <field name="model">pharmadus.palet.labels.wizard</field>
        <field name="arch" type="xml">
            <form string="Etiquetas de palet">
                <group>
                    <field name="picking_id" invisible="1"/>
                    <field name="report_type" widget="radio"/>
                </group>
                <footer>
                    <button name="action_print"
                            string="Imprimir"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancelar"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
